# Configuration Template for AI Camera System

# Database Settings (PostgreSQL + pgvector)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=face_rec_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/face_rec_db

# Active AI Combo Strategy: YUNET_SFACE | RETINAFACE_ARCFACE | HYBRID_CASCADE
ACTIVE_AI_COMBO=YUNET_SFACE

# Camera Agent Source: 0 (Webcam), RTSP URL (rtsp://...), or Video File path
CAMERA_SOURCE=0
CAMERA_FPS=30
CAMERA_RECONNECT_INTERVAL=5.0

# Face Quality Gate Thresholds
QUALITY_MIN_FACE_SIZE=40
QUALITY_BLUR_THRESHOLD=80.0
QUALITY_MIN_BRIGHTNESS=40.0
QUALITY_MAX_BRIGHTNESS=220.0
QUALITY_MAX_POSE_ANGLE=30.0

# Cosine Similarity Matching Thresholds
SIMILARITY_RECOGNIZED_THRESHOLD=0.65
SIMILARITY_UNCERTAIN_THRESHOLD=0.45

# Cooldown for Anti-Duplicate Check-in (seconds)
CHECKIN_COOLDOWN_SECONDS=300
